{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  // Any rulesync target/feature works here; `npx rulesync generate --help` lists them.
  // With "rules" enabled and several targets writing AGENTS.md, the last target wins — keep codexcli last.
  "targets": [__TARGETS__],
  "features": [__FEATURES__],
  "sources": [
    // agentbase entries are generated from agentbase.json on adoption and on every sync; change
    // groups there. Sources you add yourself are left alone (keep one entry per line).
  ]
}
