{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  // Skills only: rulesync never touches AGENTS.md / CLAUDE.md, each repo keeps its own.
  // claudecode → .claude/skills/ (Claude Code), codexcli → .agents/skills/ (Cursor, Codex, Antigravity).
  "targets": ["claudecode", "codexcli"],
  "features": ["skills"],
  "sources": [
    // Bumped automatically by agentbase's sync workflow. Do not edit by hand.
    { "source": "__ORG__/agentbase", "ref": "__REF__", "skills": ["*"] }
  ]
}
