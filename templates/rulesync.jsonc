{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": ["claudecode", "cursor", "codexcli", "copilot", "antigravity-cli"],
  "features": ["rules", "skills"],
  "sources": [
    // Bumped automatically by agentbase's sync workflow. Do not edit by hand.
    { "source": "__ORG__/agentbase", "ref": "__REF__", "rules": ["*"], "skills": ["*"] }
  ]
}
