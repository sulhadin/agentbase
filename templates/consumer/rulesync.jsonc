{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  // agentbase keeps "features" and "inputRoots" in step with .agentbase/ on every sync.
  // .agentbase/ is agentbase's content; .rulesync/ is this repo's own and wins on a name clash.
  "targets": [__TARGETS__],
  "features": ["skills"],
  "inputRoots": [".agentbase", ".rulesync"]
}
