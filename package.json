{
  "name": "agentbase",
  "version": "0.2.0",
  "private": true,
  "description": "Shared AI agent skills, subagents and commands for every consumer repo. Consumed via rulesync sources + Claude Code plugin marketplace.",
  "scripts": {
    "plugin": "rulesync generate --targets claudecode-plugin --features commands,subagents --output-roots ./plugins/agentbase --delete",
    "doctor": "rulesync doctor",
    "check": "npm run plugin && git diff --exit-code -- plugins/",
    "onboard": "scripts/onboard.sh",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "rulesync": "^16.39.0",
    "semantic-release": "^25.0.9"
  }
}
